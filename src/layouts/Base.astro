---
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import Landscape from '../components/Landscape.astro';
import SceneryPicker from '../components/SceneryPicker.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config';
import { withBase } from '../lib/posts';
import { LANDSCAPES } from '../lib/landscapes.mjs';
import '../styles/global.css';
interface Props { title?: string; description?: string; section?: string; article?: boolean; noindex?: boolean; home?: boolean; experience?: boolean; }
const { title, description = site.description, section = '全部文章', article = false, noindex = false, home = false, experience = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const scenic = home || experience;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.title}` : site.title}</title>
    <meta name="description" content={description} /><meta name="author" content={site.author} />
    <meta name="theme-color" content="#f3f5f7" /><meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('rss.xml')} />
    <meta property="og:title" content={title || site.title} /><meta property="og:description" content={description} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>try { const saved = localStorage.getItem('nitro-theme'); document.documentElement.dataset.theme = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
    <script is:inline define:vars={{ sceneryIds: LANDSCAPES.map((scene) => scene.id) }}>try { const scene = localStorage.getItem('nitro-scenery:v1'); document.documentElement.dataset.scenery = sceneryIds.includes(scene) ? scene : sceneryIds[0]; } catch { document.documentElement.dataset.scenery = sceneryIds[0]; }</script>
    <slot name="head" />
  </head>
  <body class:list={['landscape-theme', { 'is-home': home, 'is-article': article, 'is-experience': experience, 'is-scenic': scenic }]}>
    <a href="#main-content" class="skip-link">跳转到正文</a>
    <SiteHeader />
    {scenic && <Landscape />}
    <div class="workspace">
      <Sidebar article={article}><slot name="aside" slot="toc" /></Sidebar>
      <div class="workspace-main">
      {article && <header class="topbar">
        <div class="breadcrumb"><a href={withBase()}>目录</a><span class="breadcrumb-slash">/</span><span>{section}</span></div>
        <div class="topbar-right">
          {article && <button class="focus-toggle" data-focus-toggle aria-pressed="false" aria-label="开启聚焦阅读" title="隐藏侧栏，放大正文">
            <Icon name="focus" size={16} class="focus-enter-icon" />
            <Icon name="unfocus" size={16} class="focus-exit-icon" />
            <span data-focus-label>聚焦阅读</span>
          </button>}
        </div>
      </header>}
      <div class="page-layout"><main id="main-content" tabindex="-1"><slot /></main>{!article && <slot name="aside" />}</div>
      </div>
    </div>
    <footer class="site-footer">{scenic && <SceneryPicker />}<div class="footer-links"><span>© {new Date().getFullYear()} {site.author}</span><a href={withBase('rss.xml')}>RSS</a></div></footer>
    <Search />
    <script>import '../scripts/client';</script>
  </body>
</html>
