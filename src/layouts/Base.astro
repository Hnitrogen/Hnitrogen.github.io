---
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { withBase } from '../lib/posts';
import '../styles/global.css';
interface Props { title?: string; description?: string; section?: string; article?: boolean; noindex?: boolean; }
const { title, description = site.description, section = '全部文章', article = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.title}` : `${site.title} — 保持好奇，持续构建`}</title>
    <meta name="description" content={description} /><meta name="author" content={site.author} />
    <meta name="theme-color" content="#fafaf9" /><meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('rss.xml')} />
    <meta property="og:title" content={title || site.title} /><meta property="og:description" content={description} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>try { const saved = localStorage.getItem('nitro-theme'); document.documentElement.dataset.theme = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳转到正文</a>
    <Sidebar />
    <div class="workspace">
      <header class="topbar"><div class="breadcrumb"><button class="mobile-menu" data-menu-toggle aria-label="展开导航" aria-controls="site-sidebar" aria-expanded="false"><Icon name="menu" size={20} /></button><a href={withBase()}>笔记</a><span class="breadcrumb-slash">/</span><span>{section}</span></div><div class="topbar-right"><span class="topbar-motto">THINK. BUILD. WRITE.</span><button class="topbar-search" data-search-open aria-label="搜索笔记"><Icon name="search" size={17} /><kbd>⌘ K</kbd></button><a href={site.github} target="_blank" rel="noreferrer" aria-label="访问 GitHub"><Icon name="github" size={18} /></a></div></header>
      <div class="page-layout"><main id="main-content" tabindex="-1"><slot /></main><slot name="aside" /></div>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}<span class="footer-note"><span class="footer-slash">/</span>用文字整理思考</span></span><span>Built with <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a><span class="footer-slash">·</span><a href={withBase('rss.xml')}>RSS ↗</a></span></footer>
    </div>
    <Search />
    <script>import '../scripts/client';</script>
  </body>
</html>
