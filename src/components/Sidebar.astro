---
import Icon from './Icon.astro';
import { navigation } from '../config';
import { withBase } from '../lib/posts';
interface Props { article?: boolean; }
const { article = false } = Astro.props;
---
<aside class="sidebar" id="site-sidebar" aria-label="站点导航">
  <button type="button" class="mobile-nav-close" data-menu-close aria-label="关闭导航"><Icon name="close" size={20} /></button>
  <nav class="primary-nav sidebar-mobile-nav" aria-label="移动端主导航">{navigation.map(({label, path, icon}) => <a href={withBase(path)}><Icon name={icon} size={16} />{label}</a>)}</nav>
  {article && <slot name="toc" />}
</aside>
<button class="sidebar-overlay" data-menu-close aria-label="关闭导航" tabindex="-1"></button>
