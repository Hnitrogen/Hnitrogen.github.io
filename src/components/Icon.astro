---
interface Props { name: string; size?: number; class?: string; }
const { name, size = 18, class: className } = Astro.props;
// Original Xiaomi HiUI SVGs, bundled locally. License and source URLs live beside them.
const icons = import.meta.glob<string>('../assets/icons/hiui/*.svg', { eager: true, query: '?raw', import: 'default' });
const source = icons[`../assets/icons/hiui/${name}.svg`] || icons['../assets/icons/hiui/file.svg'];
const viewBox = source.match(/viewBox="([^"]+)"/)?.[1] || '0 0 1024 1024';
const content = source.slice(source.indexOf('>', source.indexOf('<svg')) + 1, source.lastIndexOf('</svg>'));
---
<svg width={size} height={size} viewBox={viewBox} fill="currentColor" class={className} aria-hidden="true" set:html={content} />
