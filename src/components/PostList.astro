---
import Icon from './Icon.astro';
import { tags, postUrl, withBase, formatDate, readingTime, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => <article class="post-row" data-post-id={post.id}>
    <div class="post-row-body">
      <div class="post-row-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.example && <span class="sample-label">示例</span>}{post.data.featured && <span class="featured-label">精选</span>}</div>
      <h2><a href={postUrl(post)}>{post.data.title}<Icon name="arrow" size={18} /></a></h2>
      <p>{post.data.description}</p>
      <div class="post-row-bottom"><div class="post-tags">{post.data.tags.map((tag) => <a href={withBase(`tags/${tag}/`)}># {tags[tag].label}</a>)}</div><span class="reading-time"><Icon name="clock" size={12} />{readingTime(post)} 分钟</span></div>
    </div>
  </article>)}
</div>
<p class="filter-empty" hidden>暂无文章。</p>
