---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCover from '../../components/PostCover.astro';
import { getPosts, categories, tags, withBase, postUrl, formatDate, readingTime } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const index = posts.findIndex((entry) => entry.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} section="index.md" article>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="article" data-pagefind-body>
    <PostCover slug={post.id} variant="article" />
    <header class="article-heading"><div class="eyebrow"><span class="sr-only" data-pagefind-filter="category">{categories[post.data.category].label}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.example && <span class="sample-label">示例文章</span>}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><p class="article-description" data-pagefind-meta="description">{post.data.description}</p><div class="article-byline"><span class="author-avatar">N</span><span>Hnitrogen</span><span>·</span><span>{readingTime(post)} 分钟阅读</span>{post.data.updatedDate && post.data.updatedDate.valueOf() > post.data.pubDate.valueOf() && <><span>·</span><span>更新于 {formatDate(post.data.updatedDate)}</span></>}</div><div class="article-tagline"><div class="post-tags">{post.data.tags.map((tag) => <a href={withBase(`tags/${tag}/`)}># {tags[tag].label}</a>)}</div><button class="copy-link" data-copy-link aria-label="复制文章链接"><Icon name="link" size={15} /><span>复制链接</span></button></div></header>
    <div class="prose"><Content /></div>
  </article>
  {(previous || next) && <nav class="article-pagination" aria-label="相邻文章">{previous ? <a href={postUrl(previous)}><span>← 上一篇记录</span><strong>{previous.data.title}</strong></a> : <span></span>}{next && <a href={postUrl(next)}><span>下一篇记录 →</span><strong>{next.data.title}</strong></a>}</nav>}
  <aside class="context-sidebar article-toc" slot="aside" aria-label="文章目录"><div class="aside-section"><h2>目录</h2><nav class="toc-nav">{toc.map((heading) => <a href={`#${heading.slug}`} class:list={[{ nested: heading.depth === 3 }]}>{heading.text}</a>)}</nav></div><a href="#main-content" class="back-to-top">回到顶部 ↑</a></aside>
</Base>
