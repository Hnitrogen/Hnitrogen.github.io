---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, postUrl } from '../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
---
<Base title="时间归档" section="时间归档"><section class="collection-heading"><h1>归档<span>{String(posts.length).padStart(2, '0')}</span></h1></section><div class="archive-list">{years.map((year) => <section class="archive-year"><h2>{year}<span class="mono">{posts.filter((post) => post.data.pubDate.getUTCFullYear() === year).length} 篇</span></h2>{posts.filter((post) => post.data.pubDate.getUTCFullYear() === year).map((post) => <a href={postUrl(post)}><time datetime={post.data.pubDate.toISOString()} class="mono">{formatDate(post.data.pubDate, true)}</time><span>{post.data.title}</span><span>↗</span></a>)}</section>)}</div></Base>
